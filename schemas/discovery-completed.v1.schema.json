{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:businesshub:schema:com.businesshub.local-businesses.discovery-completed.v1",
  "title": "Local business discovery sweep completed",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "name", "areaCount", "groups", "recordsSeen", "recordsCreated", "recordsUpdated", "completedAt"],
  "properties": {
    "jobId": { "type": "string", "minLength": 16, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "areaCount": { "type": "integer", "minimum": 1, "maximum": 50 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["shop", "craft", "office", "amenity", "tourism", "healthcare", "leisure"] }
    },
    "recordsSeen": { "type": "integer", "minimum": 0 },
    "recordsCreated": { "type": "integer", "minimum": 0 },
    "recordsUpdated": { "type": "integer", "minimum": 0 },
    "completedAt": { "type": "string", "format": "date-time" }
  }
}
